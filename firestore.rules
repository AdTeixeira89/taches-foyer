rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Family Play : chaque foyer est rangé sous foyers/<code>, un code secret de 12 caractères
    // connu de la seule famille. Il faut être connecté (connexion anonyme Firebase) et connaître
    // le code : aucune liste des foyers n'est possible.
    match /foyers/{code}/{col}/{id} {
      allow read, write: if request.auth != null
        && code.matches('^[A-Z0-9]{12}$')
        && col in ['tasks', 'ideas', 'events', 'points', 'weeks', 'pacts', 'jokers', 'spins', 'missions', 'settings'];
    }

    // Notifications push : chaque téléphone y enregistre son jeton (écriture seule, jamais de
    // lecture ni de liste côté application). Seules les Cloud Functions les lisent pour envoyer.
    match /foyers/{code}/devices/{id} {
      allow create, update: if request.auth != null
        && code.matches('^[A-Z0-9]{12}$')
        && request.resource.data.keys().hasOnly(['token', 'who', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() < 1000
        && request.resource.data.who is string
        && request.resource.data.who.size() < 20;
      allow delete: if request.auth != null
        && code.matches('^[A-Z0-9]{12}$');
    }
  }
}
